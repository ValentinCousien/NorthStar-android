@Composable
private fun AddMoodEntryViewPreview() {
    MaterialTheme {
        AddMoodEntryView(
            isPresented = true,
            onDismiss = {}
        )
    }
}

@Preview(showBackground = true)
@Composable
private fun MoodSelectorViewPreview() {
    MaterialTheme {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .padding(Spacing.screenEdge)
        ) {
            MoodSelectorView(
                selectedMood = MoodLevel.NEUTRAL,
                onMoodSelected = {}
            )
        }
    }
}
