/**
 * Composable for adding or editing a mood entry
 * 
 * This view allows users to:
 * - Select their current mood level (0-8 scale)
 * - Optionally add energy and anxiety levels 
 * - Add notes about their mood
 * - Save the entry to their mood history
 * 
 * @param isPresented Binding to control the sheet presentation
 * @param viewModel The mood tracking view model
 * @param onDismiss Callback when the sheet should be dismissed
 */
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun AddMoodEntryView(
    isPresented: Boolean = true,
    viewModel: MoodTrackingViewModel = hiltViewModel(),
    onDismiss: () -> Unit = {}
) {
    val userSettings by viewModel.userSettings.collectAsState()
    
    // Form state
    var selectedMoodLevel by remember { mutableStateOf(MoodLevel.NEUTRAL) }
    var notes by remember { mutableStateOf("") }
    var energyLevel by remember { mutableStateOf(5f) }
    var anxietyLevel by remember { mutableStateOf(0f) }

    if (isPresented) {
        Scaffold(
            topBar = {
                TopAppBar(
                    title = {
                        Text(
                            text = Strings.Mood.recordTitle,
                            style = Typography.headlineSmall,
                            color = DesignTokens.Colors.textPrimary
                        )
                    },
                    navigationIcon = {
                        IconButton(onClick = onDismiss) {
                            Text(
                                text = Strings.Common.cancel,
                                style = Typography.bodyMedium,
                                color = DesignTokens.Colors.accent
                            )
                        }
                    },
                    actions = {
                        IconButton(onClick = {
                            saveMoodEntry(
                                viewModel = viewModel,
                                selectedMoodLevel = selectedMoodLevel,
                                notes = notes,
                                energyLevel = energyLevel.toDouble(),
                                anxietyLevel = anxietyLevel.toDouble(),
                                onDismiss = onDismiss
                            )
                        }) {
                            Text(
                                text = Strings.Common.save,
                                style = Typography.bodyMedium,
                                color = DesignTokens.Colors.accent
                            )
                        }
                    },
                    colors = TopAppBarDefaults.topAppBarColors(
                        containerColor = DesignTokens.Colors.cardBackground
                    )
                )
            },
            containerColor = DesignTokens.Colors.cardBackground
        ) { paddingValues ->
            Column(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(paddingValues)
                    .verticalScroll(rememberScrollState())
                    .padding(horizontal = Spacing.screenEdge),
                verticalArrangement = Arrangement.spacedBy(Spacing.lg)
            ) {
                Spacer(modifier = Modifier.height(Spacing.md))
                
                // Mood Selector
                MoodSelectorView(
                    selectedMood = selectedMoodLevel,
                    onMoodSelected = { selectedMoodLevel = it }
                )

                // Energy Level Slider (if enabled)
                if (userSettings.energyTrackingEnabled) {
                    NSSlider(
                        title = Strings.Mood.energyLevel,
                        value = energyLevel,
                        onValueChange = { energyLevel = it },
                        range = 0f..10f,
                        steps = 9,
                        labels = listOf(
                            Strings.Mood.energyVeryLow,
                            Strings.Mood.energyAverage,
                            Strings.Mood.energyVeryHigh
                        )
                    )
                }

                // Anxiety Level Slider (if enabled)
                if (userSettings.anxietyTrackingEnabled) {
                    NSSlider(
                        title = Strings.Mood.anxietyLevel,
                        value = anxietyLevel,
                        onValueChange = { anxietyLevel = it },
                        range = 0f..10f,
                        steps = 9,
                        labels = listOf(
                            Strings.Mood.anxietyNone,
                            Strings.Mood.anxietyModerate,
                            Strings.Mood.anxietySevere
                        )
                    )
                }

                // Notes Section
                Column(
                    modifier = Modifier.fillMaxWidth(),
                    verticalArrangement = Arrangement.spacedBy(Spacing.xs)
                ) {
                    Text(
                        text = Strings.Mood.notesLabel,
                        style = Typography.bodySmall,
                        color = DesignTokens.Colors.textSecondary
                    )
                    
                    OutlinedTextField(
                        value = notes,
                        onValueChange = { notes = it },
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(120.dp),
                        textStyle = Typography.bodyMedium.copy(
                            color = DesignTokens.Colors.textPrimary
                        ),
                        shape = RoundedCornerShape(Spacing.CornerRadius.sm),
                        placeholder = {
                            Text(
                                text = Strings.Mood.addNote,
                                style = Typography.bodyMedium,
                                color = DesignTokens.Colors.textSecondary
                            )
                        }
                    )
                }
                
                Spacer(modifier = Modifier.height(Spacing.lg))
            }
        }
    }
}

/**
 * Mood selector component that displays current selection and allows mood picking
 */
@Composable
private fun MoodSelectorView(
    selectedMood: MoodLevel,
    onMoodSelected: (MoodLevel) -> Unit
) {
    Column(
        modifier = Modifier.fillMaxWidth(),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.spacedBy(Spacing.md)
    ) {
        // Question prompt
        Text(
            text = Strings.Mood.howFeeling,
            style = Typography.titleMedium,
            color = DesignTokens.Colors.textPrimary,
            textAlign = TextAlign.Center
        )
        
        // Current mood display
        Column(
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.spacedBy(Spacing.xs)
        ) {
            Icon(
                imageVector = selectedMood.icon,
                contentDescription = selectedMood.getName(),
                modifier = Modifier.size(60.dp),
                tint = selectedMood.getColor()
            )
            
            Text(
                text = selectedMood.getName(),
                style = Typography.bodyLarge,
                color = DesignTokens.Colors.textPrimary
            )
        }
        
        // Mood level indicator circles
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceEvenly,
            verticalAlignment = Alignment.CenterVertically
        ) {
            MoodLevel.entries.forEach { level ->
                MoodCircleButton(
                    moodLevel = level,
                    isSelected = level == selectedMood,
                    onClick = { onMoodSelected(level) }
                )
            }
        }
        
        // Mood scale slider for precise selection
        NSSlider(
            title = "",
            value = selectedMood.value.toFloat(),
            onValueChange = { value ->
                MoodLevel.fromValue(value.toInt())?.let { moodLevel ->
                    onMoodSelected(moodLevel)
                }
            },
            range = 0f..8f,
            steps = 7,
            labels = emptyList(),
            accentColor = selectedMood.getColor()
        )
    }
}

/**
 * Individual mood circle button for mood selection
 */
@Composable
private fun MoodCircleButton(
    moodLevel: MoodLevel,
    isSelected: Boolean,
    onClick: () -> Unit
) {
    IconButton(
        onClick = onClick,
        modifier = Modifier.size(32.dp)
    ) {
        Box(
            modifier = Modifier
                .size(24.dp)
                .background(
                    color = if (isSelected) {
                        moodLevel.getColor()
                    } else {
                        moodLevel.getColor().copy(alpha = 0.3f)
                    },
                    shape = RoundedCornerShape(12.dp)
                ),
            contentAlignment = Alignment.Center
        ) {
            if (isSelected) {
                // Show a small indicator when selected
                Box(
                    modifier = Modifier
                        .size(8.dp)
                        .background(
                            color = Color.White,
                            shape = RoundedCornerShape(4.dp)
                        )
                )
            }
        }
    }
}

/**
 * Saves the mood entry with the current form values
 */
private fun saveMoodEntry(
    viewModel: MoodTrackingViewModel,
    selectedMoodLevel: MoodLevel,
    notes: String,
    energyLevel: Double,
    anxietyLevel: Double,
    onDismiss: () -> Unit
) {
    // Create entry from form values
    val entry = MoodEntry(
        date = Clock.System.now(),
        level = selectedMoodLevel,
        notes = notes,
        energyLevel = energyLevel,
        anxietyLevel = anxietyLevel
    )

    // Check if there's an existing entry for today
    val existingEntry = viewModel.getEntry(Clock.System.now())
    
    if (existingEntry != null) {
        // Update existing entry
        val updatedEntry = entry.copy(id = existingEntry.id)
        viewModel.updateEntry(updatedEntry)
    } else {
        // Add new entry
        viewModel.addEntry(entry)
    }

    onDismiss()
}

