/**
 * Main mood tracking view that displays mood history and provides access to mood entry functionality
 * 
 * This view shows:
 * - Page header with title and current date
 * - Today's mood summary card (when implemented)
 * - Mood trends visualization (when implemented) 
 * - Recent mood history list
 * - Floating action button to add new mood entries
 * 
 * @param viewModel The mood tracking view model
 * @param onAddMoodClick Callback when the add mood FAB is clicked
 * @param onMoodEntryClick Callback when a mood entry is selected
 */
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MoodLogView(
    viewModel: MoodTrackingViewModel = hiltViewModel(),
    onAddMoodClick: () -> Unit = {},
    onMoodEntryClick: (String) -> Unit = {}
) {
    val moodEntries by viewModel.moodEntries.collectAsState()
    var showAddMoodEntry by remember { mutableStateOf(false) }

    Scaffold(
        floatingActionButton = {
            FloatingActionButton(
                onClick = { showAddMoodEntry = true },
                containerColor = DesignTokens.Colors.accent,
                contentColor = DesignTokens.Colors.surface
            ) {
                Icon(
                    imageVector = Icons.Default.Add,
                    contentDescription = Strings.Mood.addEntry
                )
            }
        },
        containerColor = DesignTokens.Colors.background
    ) { paddingValues ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(paddingValues)
        ) {
            // Header Section
            MoodLogHeader()
            
            // Main Content
            LazyColumn(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(horizontal = Spacing.screenEdge),
                verticalArrangement = Arrangement.spacedBy(Spacing.lg)
            ) {
                // Today's Mood Card (placeholder for future implementation)
                item {
                    TodayMoodCardPlaceholder(
                        onAddMoodClick = { showAddMoodEntry = true }
                    )
                }
                
                // Mood Trends Card (placeholder for future implementation)
                item {
                    MoodTrendsCardPlaceholder()
                }
                
                // Recent Mood History
                item {
                    RecentMoodHistoryCard(
                        moodEntries = moodEntries,
                        onEntryClick = onMoodEntryClick
                    )
                }
            }
        }
    }
    
    // Add Mood Entry Sheet
    if (showAddMoodEntry) {
        AddMoodEntryView(
            isPresented = showAddMoodEntry,
            viewModel = viewModel,
            onDismiss = { showAddMoodEntry = false }
        )
    }
}

/**
 * Header component for the mood log view showing title and current date
 */
@Composable
private fun MoodLogHeader() {
    val currentDate = remember { Date() }
    val dateFormatter = remember { 
        SimpleDateFormat("EEEE, MMMM dd, yyyy", Locale.getDefault()) 
    }
    
    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(
                horizontal = Spacing.screenEdge,
                vertical = Spacing.md
            ),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.spacedBy(Spacing.sm)
    ) {
        Text(
            text = Strings.Mood.title,
            style = Typography.headlineMedium,
            color = DesignTokens.Colors.textPrimary
        )
        
        Text(
            text = dateFormatter.format(currentDate),
            style = Typography.titleSmall,
            color = DesignTokens.Colors.textSecondary
        )
    }
}

