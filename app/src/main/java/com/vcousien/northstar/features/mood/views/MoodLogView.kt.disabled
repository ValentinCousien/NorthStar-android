/**
 * Card showing recent mood history entries
 * 
 * @param moodEntries List of mood entries to display
 * @param onEntryClick Callback when an entry is clicked
 */
@Composable
private fun RecentMoodHistoryCard(
    moodEntries: List<MoodEntry>,
    onEntryClick: (String) -> Unit
) {
    val recentEntries = remember(moodEntries) {
        moodEntries.sortedByDescending { it.dateAsInstant }.take(5)
    }
    
    NSCard {
        Column(
            modifier = Modifier.fillMaxWidth(),
            verticalArrangement = Arrangement.spacedBy(Spacing.md)
        ) {
            Text(
                text = Strings.Mood.moodHistory,
                style = Typography.titleMedium,
                color = DesignTokens.Colors.textPrimary
            )
            
            if (recentEntries.isEmpty()) {
                NSEmptyState(
                    title = Strings.Mood.noEntries,
                    subtitle = Strings.Mood.noEntriesDescription,
                    modifier = Modifier.padding(vertical = Spacing.md)
                )
            } else {
                recentEntries.forEachIndexed { index, entry ->
                    MoodHistoryItem(
                        entry = entry,
                        onClick = { onEntryClick(entry.id) }
                    )
                    
                    if (index < recentEntries.lastIndex) {
                        HorizontalDivider(
                            color = DesignTokens.Colors.divider,
                            thickness = 1.dp
                        )
                    }
                }
            }
        }
    }
}

/**
 * Individual mood history entry item
 * 
 * @param entry The mood entry to display
 * @param onClick Callback when the item is clicked
 */
@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun MoodHistoryItem(
    entry: MoodEntry,
    onClick: () -> Unit
) {
    val dateFormatter = remember { 
        SimpleDateFormat("MMM dd, yyyy", Locale.getDefault()) 
    }
    
    Card(
        onClick = onClick,
        colors = CardDefaults.cardColors(
            containerColor = DesignTokens.Colors.surface
        ),
        shape = RoundedCornerShape(Spacing.CornerRadius.sm),
        modifier = Modifier.fillMaxWidth()
    ) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(Spacing.sm),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.SpaceBetween
        ) {
            // Date
            Text(
                text = dateFormatter.format(Date(entry.dateAsInstant.toEpochMilliseconds())),
                style = Typography.bodyMedium,
                color = DesignTokens.Colors.textPrimary
            )
            
            // Mood level info
            Row(
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.spacedBy(Spacing.xs)
            ) {
                Icon(
                    imageVector = entry.level.icon,
                    contentDescription = entry.level.getName(),
                    modifier = Modifier.size(20.dp),
                    tint = entry.level.getColor()
                )
                
                Text(
                    text = entry.level.getName(),
                    style = Typography.bodySmall,
                    color = DesignTokens.Colors.textSecondary
                )
                
                Spacer(modifier = Modifier.width(Spacing.sm))
                
                Icon(
                    imageVector = Icons.Default.ChevronRight,
                    contentDescription = "View details",
                    modifier = Modifier.size(16.dp),
                    tint = DesignTokens.Colors.textSecondary
                )
            }
        }
    }
}

